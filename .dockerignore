.git
.gitignore
.gitattributes
.github

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Docker files (don't copy into image)
Dockerfile*
docker-compose*.yml
.dockerignore

