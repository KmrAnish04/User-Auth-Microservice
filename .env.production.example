# Application
NODE_ENV=production
PORT=3000

# MongoDB Authentication
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=YourSecurePassword123!

# Update MongoDB connection URL
MONGO_DB_URL=mongodb://admin:YourSecurePassword123!@mongodb:27017/sso-auth-db?authSource=admin
# MongoDB (internal Docker network)
MONGO_DB_URL=mongodb://mongodb:27017/sso-auth-db

# Redis (internal Docker network)
REDIS_DB_URL=redis://redis:6379

# Google OAuth Credentials
Google_Client_ID=YOUR_GOOGLE_CLIENT_ID_HERE
Google_Client_Secret=YOUR_GOOGLE_CLIENT_SECRET_HERE

# JWT Secret
REFRESH_TOKEN_SECRET=YOUR_REFRESH_TOKEN_SECRET_HERE

# Application Tokens (generate with: node src/generateAppTokens.js)
sso_consumer=KEY_YOUR_TOKEN_HERE
local_consumer=KEY_YOUR_TOKEN_HERE
singleSignOn_consumer=KEY_YOUR_TOKEN_HERE

# Token mappings
KEY_WEMrm1j06ECrQ0NLGROXF6p2lxYy=sso_consumer
KEY_l1Q7zkOL59cRqWBkQ12ZiGVW2DBL=local_consumer
KEY_NMLLXOJlpGtk5kxDL5kRSmR0jW5V=singleSignOn_consumer
